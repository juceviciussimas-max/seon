    "faq": {
      "type": "faq",
      "settings": {
        "heading": "Questions"
      },
      "blocks": {
        "q0": {
          "type": "q",
          "settings": {
            "q": "How long does delivery take?",
            "a": "<p>Delivery to the US takes 7 to 12 business days and shipping is free. You get a tracking link by email as soon as your parcel ships.</p>"
          }
        },
        "q1": {
          "type": "q",
          "settings": {
            "q": "How does the bundle discount work?",
            "a": "<p>Whenever a posture belt and a V-line strap are in your cart together, each strap (up to two) gets $9.99 off automatically. No code needed.</p>"
          }
        },
        "q2": {
          "type": "q",
          "settings": {
            "q": "Which belt size should I choose?",
            "a": "<p>The belt adjusts with velcro. Choose your usual top size, and if you are between sizes, choose the larger one.</p>"
          }
        },
        "q3": {
          "type": "q",
          "settings": {
            "q": "How long should I wear them?",
            "a": "<p>Start with 20 to 30 minutes a day for each. Take them off if anything feels tight or uncomfortable.</p>"
          }
        },
        "q4": {
          "type": "q",
          "settings": {
            "q": "How do I clean them?",
            "a": "<p>Hand wash in cool water with a little mild soap and let them air dry. Do not tumble dry.</p>"
          }
        }
      },
