<section class="s-hero" data-hero aria-labelledby="hero-title-{{ section.id }}">
  <div class="container s-hero__grid">
    <div class="s-hero__copy">
      <h1 id="hero-title-{{ section.id }}" class="s-hero__title">
        <span class="line"><span>{{ section.settings.line1 }}</span></span>
        <span class="line"><span>{{ section.settings.line2 }}</span></span>
      </h1>
      <p class="s-hero__lead">{{ section.settings.text }}</p>
      {%- assign strap = all_products[settings.strap_handle] -%}
      {%- assign belt = all_products[settings.belt_handle] -%}
      <div class="s-hero__cta">
        <a class="btn btn--accent btn--shine" href="{{ section.settings.button_link | default: '#shop' }}" data-scroll-to>{{ section.settings.button_label }}{% render 'icon', name: 'arrow' %}</a>
        {%- if strap.id and belt.id -%}
          {%- assign full = strap.price | plus: belt.price -%}
          {%- assign now = settings.bundle_discount | default: '9.99' | times: 100 | round -%}
          {%- assign now = full | minus: now -%}
          <span class="s-hero__price"><strong>{{ now | money }}</strong> <s>{{ full | money }}</s><small>{{ section.settings.price_label }}</small></span>
        {%- endif -%}
      </div>
      <p class="s-hero__note">{% render 'icon', name: 'truck' %}<span>{{ section.settings.note }}</span>{% if section.settings.alt_label != blank %}<a class="text-link" href="{{ section.settings.alt_link }}" data-scroll-to>{{ section.settings.alt_label }}</a>{% endif %}</p>
    </div>
    <figure class="s-hero__media" data-hero-media>
      {%- if section.settings.image -%}
        {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(max-width: 860px) 92vw, 44vw', widths: '600, 900, 1200, 1400', alt: section.settings.image.alt }}
      {%- else -%}
        <img src="{{ 'hero-model-1200.webp' | asset_url }}" srcset="{{ 'hero-model-700.webp' | asset_url }} 700w, {{ 'hero-model-1200.webp' | asset_url }} 1200w" sizes="(max-width: 860px) 92vw, 44vw" width="1200" height="1490" alt="A woman with her eyes closed wearing a soft pink V-line strap around her chin" fetchpriority="high">
      {%- endif -%}
    </figure>
  </div>
</section>
{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "line1", "label": "Headline line 1", "default": "Your overnight" },
    { "type": "text", "id": "line2", "label": "Headline line 2", "default": "line ritual." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "A soft V-line strap you wear while you sleep, and a light posture belt for your days." },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Buy now" },
    { "type": "text", "id": "button_link", "label": "Button link", "default": "/pages/seon-set" },
    { "type": "text", "id": "price_label", "label": "Price note", "default": "The Seon Set" },
    { "type": "text", "id": "note", "label": "Note under the button", "default": "Free tracked US shipping. 30-day returns." },
    { "type": "text", "id": "alt_label", "label": "Second link", "default": "Shop all" },
    { "type": "text", "id": "alt_link", "label": "Second link URL", "default": "#shop" },
    { "type": "image_picker", "id": "image", "label": "Image (optional, replaces the default)" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
