{%- assign strap = all_products[settings.strap_handle] -%}
{%- assign belt = all_products[settings.belt_handle] -%}
<section class="section shop2" id="shop" aria-labelledby="shop-title-{{ section.id }}">
  <div class="container">
    <div class="section__head">
      <h2 id="shop-title-{{ section.id }}" class="section__title" data-reveal>{{ section.settings.heading }}</h2>
      <a class="text-link" href="{{ routes.all_products_collection_url }}" data-reveal>Shop all</a>
    </div>
    <div class="shop2__grid">
      {% render 'offer-card', kind: 'set', wide: true, tag: 'Most popular', title: 'The Seon Set', text: 'The strap and the belt together, for your face and your shoulders.', strap_qty: 1, belt_qty: 1, image: 'set-lifestyle', alt: 'A woman wearing the pink V-line strap and the white posture belt', url: section.settings.set_url %}
      {%- if strap.id -%}{% render 'product-card', product: strap %}{%- endif -%}
      {%- if belt.id -%}{% render 'product-card', product: belt %}{%- endif -%}
      {% render 'offer-card', kind: 'box', wide: true, flip: true, tag: 'Best value', title: 'The Ritual Box', text: 'Two V-line straps and one posture belt. One for you, one to share, or a spare for travel.', strap_qty: 2, belt_qty: 1, image: 'box-flat', alt: 'Two pink V-line straps and one white posture belt laid out together', url: section.settings.box_url %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Collection showcase",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The collection" },
    { "type": "text", "id": "set_url", "label": "Seon Set page link", "default": "/pages/seon-set" },
    { "type": "text", "id": "box_url", "label": "Ritual Box page link", "default": "/pages/ritual-box" }
  ],
  "presets": [{ "name": "Collection showcase" }]
}
{% endschema %}
