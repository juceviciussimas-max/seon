<section class="section posture" aria-labelledby="posture-title-{{ section.id }}">
  <div class="container posture__grid">
    <figure class="posture__media" data-parallax>
      {%- if section.settings.image -%}
        {{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: section.settings.image.alt }}
      {%- else -%}
        <img src="{{ 'belt-lifestyle-1200.webp' | asset_url }}" srcset="{{ 'belt-lifestyle-700.webp' | asset_url }} 700w, {{ 'belt-lifestyle-1200.webp' | asset_url }} 1136w" sizes="(max-width: 860px) 92vw, 45vw" width="1136" height="1408" alt="A woman wearing the white posture belt over a cream top, seen from behind" loading="lazy">
      {%- endif -%}
    </figure>
    <div class="posture__copy">
      <h2 id="posture-title-{{ section.id }}">{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
      <ul class="posture__tips">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}><strong>{{ block.settings.title }}</strong><span>{{ block.settings.text }}</span></li>
        {%- endfor -%}
      </ul>
      {%- assign belt = all_products[settings.belt_handle] -%}
      {%- if belt.url -%}<a class="text-link" href="{{ belt.url }}">{{ section.settings.link_label }}</a>{%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Posture",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shoulders back, without thinking about it." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "The posture belt is thin enough to wear under a top. When you start to slouch, it gently pulls your shoulders back and reminds you to sit tall." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "See the posture belt" },
    { "type": "image_picker", "id": "image", "label": "Image" }
  ],
  "blocks": [
    { "type": "tip", "name": "Tip", "settings": [
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "text", "id": "text", "label": "Text" }
    ] }
  ],
  "presets": [{ "name": "Posture" }]
}
{% endschema %}
