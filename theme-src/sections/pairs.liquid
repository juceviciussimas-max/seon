{%- assign strap = all_products[settings.strap_handle] -%}
{%- assign belt = all_products[settings.belt_handle] -%}
{%- if product.handle == strap.handle -%}{%- assign other = belt -%}{%- else -%}{%- assign other = strap -%}{%- endif -%}
{%- if other.id -%}
<section class="section pairs" aria-labelledby="pairs-title-{{ section.id }}">
  <div class="container">
    <h2 id="pairs-title-{{ section.id }}" class="section__title">{{ section.settings.heading }}</h2>
    <div class="pairs__grid">
      {% render 'product-card', product: other %}
      <div class="pairs__note">
        <p class="pairs__big">Wear them together and save {{ settings.bundle_discount | times: 100 | round | money }} on each strap.</p>
        <p>The discount is applied automatically in your cart whenever a posture belt and a V-line strap are in it.</p>
      </div>
    </div>
  </div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "Pairs well with",
  "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Pairs well with" } ],
  "presets": [{ "name": "Pairs well with" }]
}
{% endschema %}
