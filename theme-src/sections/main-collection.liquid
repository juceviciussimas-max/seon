<section class="section shop2 shop2--page">
  <div class="container">
    <h1 class="section__title">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}<div class="page-lead rte">{{ collection.description }}</div>{%- endif -%}
    {%- paginate collection.products by 24 -%}
      <div class="shop2__grid">
        {%- for product in collection.products -%}{% render 'product-card', product: product %}{%- else -%}<p>No products here yet.</p>{%- endfor -%}
      </div>
    {%- endpaginate -%}
  </div>
</section>
{% schema %}{ "name": "Collection" }{% endschema %}
