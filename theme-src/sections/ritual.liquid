<section class="ritual" id="ritual" data-ritual aria-labelledby="ritual-title-{{ section.id }}">
  <div class="ritual__stage">
    <div class="container ritual__grid">
      <div class="ritual__copy">
        <h2 id="ritual-title-{{ section.id }}">{{ section.settings.heading }}</h2>
        <ol class="ritual__steps">
          {%- for block in section.blocks -%}
            <li class="ritual__step{% if forloop.first %} is-active{% endif %}" data-step="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
              <span class="ritual__num">{{ forloop.index }}</span>
              <div><strong>{{ block.settings.title }}</strong><p>{{ block.settings.text }}</p></div>
            </li>
          {%- endfor -%}
        </ol>
      </div>
      <div class="ritual__frame" aria-hidden="true">
        {%- for block in section.blocks -%}
          {%- if block.settings.image -%}
            {{ block.settings.image | image_url: width: 900 | image_tag: class: 'ritual__img', loading: 'lazy', alt: '', data-step-img: forloop.index0 }}
          {%- else -%}
            <img class="ritual__img{% if forloop.first %} is-active{% endif %}" data-step-img="{{ forloop.index0 }}" src="{{ block.settings.fallback | asset_url }}" alt="" loading="lazy" width="800" height="800">
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Ritual steps",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "How to wear it" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "fallback", "label": "Fallback image asset", "default": "strap-1.webp" }
      ]
    }
  ],
  "presets": [{ "name": "Ritual steps" }]
}
{% endschema %}
