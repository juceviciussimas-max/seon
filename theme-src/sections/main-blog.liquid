<section class="container prose">
  <h1>{{ blog.title }}</h1>
  {%- for article in blog.articles -%}<h2><a href="{{ article.url }}">{{ article.title }}</a></h2><p>{{ article.excerpt_or_content | strip_html | truncatewords: 40 }}</p>{%- endfor -%}
</section>
{% schema %}{ "name": "Blog" }{% endschema %}
