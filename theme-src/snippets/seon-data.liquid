{%- comment -%}
  Product data for the bundle picker, quick-add cards and cart upsells.
  Prices are in cents, as Shopify's cart API uses.
{%- endcomment -%}
{%- assign strap = all_products[settings.strap_handle] -%}
{%- assign belt = all_products[settings.belt_handle] -%}
{%- assign protection = all_products[settings.protection_handle] -%}
<script>
  window.Seon = {
    routes: {
      root: {{ routes.root_url | json }},
      cart: {{ routes.cart_url | json }},
      cartAdd: {{ routes.cart_add_url | json }},
      cartChange: {{ routes.cart_change_url | json }}
    },
    moneyFormat: {{ shop.money_format | json }},
    bundleDiscount: {{ settings.bundle_discount | default: '9.99' | times: 100 | round }},
    delivery: { min: {{ settings.delivery_min | default: 7 }}, max: {{ settings.delivery_max | default: 12 }} },
    atc: {{ settings.atc_behavior | default: 'drawer' | json }},
    lowStock: {{ settings.low_stock_threshold | default: 15 }},
    bundleImages: { set: {{ 'set-flat-700.webp' | asset_url | json }}, box: {{ 'box-flat-700.webp' | asset_url | json }} },
    protection: {% if settings.protection_enabled and protection.id and protection.available %}{ handle: {{ protection.handle | json }}, variant: {{ protection.selected_or_first_available_variant.id }}, price: {{ protection.price }} }{% else %}null{% endif %},
    products: {
      strap: {% if strap.id %}{
        id: {{ strap.id }}, handle: {{ strap.handle | json }}, title: {{ strap.title | json }}, url: {{ strap.url | json }},
        image: {{ strap.featured_image | image_url: width: 240 | json }},
        variants: [{% for v in strap.variants %}{ id: {{ v.id }}, title: {{ v.title | json }}, price: {{ v.price }}, available: {{ v.available }}, inv: {% if v.inventory_management == 'shopify' %}{{ v.inventory_quantity }}{% else %}null{% endif %} }{% unless forloop.last %},{% endunless %}{% endfor %}]
      }{% else %}null{% endif %},
      belt: {% if belt.id %}{
        id: {{ belt.id }}, handle: {{ belt.handle | json }}, title: {{ belt.title | json }}, url: {{ belt.url | json }},
        image: {{ belt.featured_image | image_url: width: 240 | json }},
        variants: [{% for v in belt.variants %}{ id: {{ v.id }}, title: {{ v.title | json }}, price: {{ v.price }}, available: {{ v.available }}, inv: {% if v.inventory_management == 'shopify' %}{{ v.inventory_quantity }}{% else %}null{% endif %} }{% unless forloop.last %},{% endunless %}{% endfor %}]
      }{% else %}null{% endif %}
    }
  };
</script>
