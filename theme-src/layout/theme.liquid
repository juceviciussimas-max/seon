<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content">
  <meta name="theme-color" content="#fffbf7">
  <title>{{ page_title }}{% unless page_title contains shop.name %} | {{ shop.name }}{% endunless %}</title>
  {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}
  <link rel="canonical" href="{{ canonical_url }}">
  <meta property="og:site_name" content="{{ shop.name | escape }}">
  <meta property="og:title" content="{{ page_title | escape }}">
  <meta property="og:url" content="{{ canonical_url }}">
  {%- if product and product.featured_image -%}
    <meta property="og:type" content="product">
    <meta property="og:image" content="https:{{ product.featured_image | image_url: width: 1200 }}">
  {%- else -%}
    <meta property="og:type" content="website">
    <meta property="og:image" content="https:{{ 'hero-model-1200.webp' | asset_url }}">
  {%- endif -%}
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%23f6dcdf'/%3E%3Ctext x='32' y='44' text-anchor='middle' font-family='sans-serif' font-size='34' fill='%233a2a2e'%3E%EC%84%A0%3C/text%3E%3C/svg%3E">
  <link rel="preload" href="{{ 'bodoni-latin.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="{{ 'jost-latin.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
  {{ 'seon.css' | asset_url | stylesheet_tag }}
  <script>document.documentElement.classList.add('js');</script>
  {{ content_for_header }}
</head>
<body class="template-{{ template.name }}{% if template.suffix %} template-{{ template.name }}-{{ template.suffix }}{% endif %}">
  <a class="skip" href="#main">Skip to content</a>
  {% section 'announcement' %}
  {% section 'header' %}
  <main id="main" tabindex="-1">
    {{ content_for_layout }}
  </main>
  {% section 'footer' %}
  {% render 'cart-drawer' %}
  {% render 'seon-data' %}
  <script src="{{ 'gsap.min.js' | asset_url }}" defer></script>
  <script src="{{ 'ScrollTrigger.min.js' | asset_url }}" defer></script>
  <script src="{{ 'lenis.min.js' | asset_url }}" defer></script>
  <script src="{{ 'seon.js' | asset_url }}" defer></script>
</body>
</html>
